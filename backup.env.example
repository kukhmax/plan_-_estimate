# Stage 14D backup container settings (docs/STAGE_14D_BACKUP_RESTORE_PLAN.md §16).
# Placeholders only. The real file lives OUTSIDE the repository, e.g.
# /home/ubuntu/backups/plan-estimate/db-backup/secrets/backup.env (chmod 600),
# and is passed as an additional --env-file. It holds NO password: the
# database password exists only in <BACKUP_HOST_ROOT>/secrets/pgpass (0600).

# Host user that owns <BACKUP_HOST_ROOT> (output of `id -u` / `id -g`).
BACKUP_UID=
BACKUP_GID=

# Host directory with work/ encrypted/ evidence/ (0700) and secrets/pgpass (0600).
BACKUP_HOST_ROOT=/home/ubuntu/backups/plan-estimate/db-backup

# Connection (non-secret). Role and minimum privileges are decided after the
# scratch PostgreSQL privilege proof; the pgpass entry must match exactly:
#   <PGHOST>:<PGPORT>:<PGDATABASE>:<PGUSER>:<password>
BACKUP_PGHOST=postgres
BACKUP_PGPORT=5432
BACKUP_PGDATABASE=
BACKUP_PGUSER=
# Explicit libpq SSL mode (disable | allow | prefer | require | verify-ca | verify-full).
BACKUP_PGSSLMODE=

# Public age recipients only (age1..., comma separated). Never a private key.
BACKUP_AGE_RECIPIENTS=
