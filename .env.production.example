# Application
ENVIRONMENT=production
APP_ENV=production
DEBUG=false

# Domain
APP_DOMAIN=app.example.com

# PostgreSQL
POSTGRES_USER=plan_estimate
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=plan_estimate

# Telegram
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
MOCK_TELEGRAM_AUTH=false

# Encryption of the personal data of the clients (EN-2a): the key of the server, base64 of 32 random bytes. Make it ONCE on the server with
# `openssl rand -base64 32` and keep a copy in your password manager and on paper, apart from the backups. The backend does not start without it.
# LOSING THIS KEY LOSES THE DATA IT PROTECTS: it cannot be recovered from the database or from a backup.
DATA_KEK=CHANGE_ME_openssl_rand_base64_32
DATA_KEK_VERSION=1

# JWT
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Media storage / photos (Stage 14 — docs/STAGE_14B_MEDIA_INFRASTRUCTURE_PLAN.md §11)
# Safe defaults: storage disabled, uploads off. The application starts
# normally with these values. Real credentials go ONLY into the server's
# .env.production (chmod 600), never into Git.
MEDIA_STORAGE_BACKEND=disabled
MEDIA_STORAGE_NAME=r2-primary
# EU-jurisdiction R2 endpoint pattern: https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com (HTTPS only)
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
# Access Key ID: identifier (operationally sensitive). Secret Access Key: SECRET.
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Must stay false until the Stage 14D backup/restore gate passes and the owner enables it.
PHOTO_UPLOADS_ENABLED=false
PHOTO_SIGNED_URL_TTL_SECONDS=300
PHOTO_MAX_UPLOAD_BYTES=25000000
PHOTO_MAX_REQUEST_BYTES=27000000
PHOTO_MAX_DECODED_PIXELS=60000000
PHOTO_STORAGE_WARNING_BYTES=8000000000
PHOTO_STORAGE_SOFT_CAP_BYTES=10000000000
PHOTO_TEMP_DIR=/tmp/plan-estimate-photos
PHOTO_TEMP_STALE_AFTER_SECONDS=86400
PHOTO_PROCESSING_WAIT_SECONDS=30

# Calendar and reminders (Stage 18D). Messages to the owner's chat are sent by a loop inside the backend; it stays OFF until you set true.
# It also needs the bot token above. The address of the "Open" button defaults to https://$APP_DOMAIN.
CALENDAR_DISPATCHER_ENABLED=false
# CALENDAR_WEB_APP_URL=https://app.example.com
# CALENDAR_DISPATCH_INTERVAL_SECONDS=60
# CALENDAR_RECONCILE_INTERVAL_SECONDS=600
