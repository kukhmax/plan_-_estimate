{% set severities = {'LOW': t('photo_report.severity.low'), 'MEDIUM': t('photo_report.severity.medium'), 'HIGH': t('photo_report.severity.high'), 'CRITICAL': t('photo_report.severity.critical')} %}
{% macro field(value) %}{% if value %}{{ value }}{% else %}<span class="write-line"></span>{% endif %}{% endmacro %}
<div class="techcard">
{% if doc.working %}<p class="notice">{{ t('techcard.working_note') }}</p>{% endif %}
{% if not (embedded | default(false)) %}
<div class="object">
  <div class="role">{{ t('estimate.object') }}</div>
  <div><strong>{{ doc.object_name }}</strong></div>
  {% for line in doc.object_lines %}<div>{{ line }}</div>{% endfor %}
</div>
{% endif %}
{% for room in doc.rooms %}
<section class="tc-room">
  <h2>{{ t('techcard.room') }}: {{ field(room.name) }}</h2>
  {% for s in room.surfaces %}
  <div class="tc-surface">
    <h3>{{ t('techcard.surface') }}: {{ field(s.name) }}{% if s.type_label %} <span class="muted">· {{ s.type_label }}</span>{% endif %}</h3>
    <table class="facts">
      <tr><td class="label">{{ t('techcard.substrate') }}</td><td>{{ field(s.substrate) }}</td></tr>
      <tr><td class="label">{{ t('techcard.quality_target') }}</td><td>{{ field(s.quality_target) }}</td></tr>
      {% if s.inspection and s.inspection.completed_on %}<tr><td class="label">{{ t('techcard.inspection_date') }}</td><td>{{ s.inspection.completed_on | date }}</td></tr>{% endif %}
    </table>
    <h4>{{ t('techcard.inspection') }}</h4>
    {% if s.inspection %}
      {% set ins = s.inspection %}
      {% for g in ins.groups %}
      <table class="answers">
        {% if g.title %}<tr class="answers-title"><td colspan="2">{{ g.title }}</td></tr>{% endif %}
        {% for r in g.rows %}<tr><td>{{ r.question }}</td><td class="answer">{{ r.answer }}</td></tr>{% endfor %}
      </table>
      {% endfor %}
      {% for risk in ins.risks %}
      <div class="risk risk-{{ risk.severity | lower }}">
        <div class="risk-title"><span class="severity">{{ severities[risk.severity] }}</span> {{ risk.title }}</div>
        <div>{{ risk.explanation }}</div>
        {% if risk.blocks_finishing %}<div class="blocks">{{ t('photo_report.blocks_finishing') }}</div>{% endif %}
      </div>
      {% endfor %}
      {% if ins.notes %}<p><strong>{{ t('photo_report.notes') }}:</strong> {{ ins.notes }}</p>{% endif %}
      {% if not ins.groups and not ins.risks and not ins.notes %}
        <p class="muted">{{ t('techcard.inspection_empty') }}</p>
        {% if doc.working %}<div class="write-box"></div>{% endif %}
      {% endif %}
    {% else %}
      <p class="muted">{{ t('techcard.inspection_none') }}</p>
      <div class="write-box"></div>
    {% endif %}
    <h4>{{ t('techcard.works') }}</h4>
    <table class="works">
      <thead>
        <tr><th class="lp">{{ t('techcard.col_no') }}</th><th>{{ t('techcard.col_work') }}</th><th class="unit">{{ t('techcard.col_unit') }}</th><th class="num">{{ t('techcard.col_quantity') }}</th><th class="brk">{{ t('techcard.col_break') }}</th></tr>
      </thead>
      <tbody>
        {% for w in s.works %}
        <tr><td class="lp">{{ w.number }}</td><td>{{ w.name }}</td><td class="unit">{{ w.unit }}</td><td class="num">{% if w.quantity %}{{ w.quantity }}{% elif doc.working %}<span class="write-line"></span>{% endif %}</td><td class="brk">{% if w.wait_hours %}{{ t('techcard.break_hours', n=w.wait_hours) }}{% elif doc.working %}<span class="write-line"></span>{% endif %}</td></tr>
        {% endfor %}
        {% for _ in range(s.spare_rows) %}
        <tr class="spare"><td class="lp">{{ s.works | length + loop.index }}</td><td><span class="write-line"></span></td><td class="unit"><span class="write-line"></span></td><td class="num"><span class="write-line"></span></td><td class="brk"><span class="write-line"></span></td></tr>
        {% endfor %}
      </tbody>
    </table>
    {% if doc.working %}
    <h4>{{ t('techcard.remarks') }}</h4>
    <div class="write-box"></div>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endfor %}
</div>
