{% extends "_layout.html.j2" %}
{% macro field(value) %}{% if value %}{{ value }}{% else %}<span class="write-line"></span>{% endif %}{% endmacro %}
{% macro boxes(options) %}{% for o in options %}<p class="alternative"><span class="box">{% if o.checked %}☒{% else %}☐{% endif %}&nbsp;{{ o.label }}</span></p>{% endfor %}{% endmacro %}
{% block body %}
<div class="handover downtime{% if doc.working %} working{% endif %}">
{% if doc.working %}<p class="notice">{{ t('downtime.working_note') }}</p>{% endif %}
<table class="facts">
  {% for row in doc.facts %}<tr><td class="label">{{ row.label }}</td><td>{{ field(row.value) }}</td></tr>{% endfor %}
</table>
<h2>{{ t('downtime.attendees') }}</h2>
{% if doc.attendees %}
<table class="works">
  <thead><tr><th>{{ t('downtime.attendees.name') }}</th><th>{{ t('downtime.attendees.role') }}</th></tr></thead>
  <tbody>{% for a in doc.attendees %}<tr><td>{{ a.name }}</td><td>{{ a.role or '' }}</td></tr>{% endfor %}</tbody>
</table>
{% else %}
<p class="muted">{{ t('downtime.attendees.none') }}</p>
{% for _ in range(3) %}<table class="facts"><tr><td class="label">{{ t('downtime.attendees.name') }}</td><td><span class="write-line"></span></td></tr></table>{% endfor %}
{% endif %}
<h2>{{ t('downtime.days') }}</h2>
<table class="works days">
  <thead><tr><th class="c-no">{{ t('downtime.days.no') }}</th><th>{{ t('downtime.days.date') }}</th><th>{{ t('downtime.days.weekday') }}</th><th>{{ t('downtime.days.other_work') }}</th><th>{{ t('downtime.days.note') }}</th></tr></thead>
  <tbody>{% for d in doc.days %}<tr><td>{{ d.number }}</td><td>{{ d.day or '' }}</td><td>{{ d.weekday or '' }}</td><td>{{ d.other_work or '' }}</td><td>{{ d.note or '' }}</td></tr>{% endfor %}</tbody>
</table>
<h2>{{ t('downtime.settlement') }}</h2>
<table class="facts">
  {% for row in doc.totals %}<tr><td class="label">{{ row.label }}</td><td>{{ field(row.value) }}</td></tr>{% endfor %}
</table>
{% if doc.cap_note %}<p class="clause">{{ doc.cap_note }}</p>{% endif %}
<p class="clause">{{ t('downtime.protocol_basis') }}</p>
<p class="clause"><strong>{{ t('downtime.deadline') }}:</strong> {{ field(doc.deadline_note) }}</p>
{{ boxes([doc.refusal]) }}
<p class="clause"><strong>{{ t('downtime.notes') }}:</strong> {{ field(doc.notes) }}</p>
</div>
{% endblock %}
