{% macro field(value) %}{% if value %}{{ value }}{% else %}<span class="write-line"></span>{% endif %}{% endmacro %}
<div class="techcard plan">
{% if doc.working %}<p class="notice">{{ t('plan.working_note') }}</p>{% endif %}
{% if not (embedded | default(false)) %}
<div class="object">
  <div class="role">{{ t('estimate.object') }}</div>
  <div><strong>{{ doc.object_name }}</strong></div>
  {% for line in doc.object_lines %}<div>{{ line }}</div>{% endfor %}
</div>
{% endif %}
<h2 class="first">{{ t('plan.sequence') }}</h2>
{% for room in doc.rooms %}
<section class="plan-room">
  <h3>{{ t('techcard.room') }}: {{ field(room.name) }}</h3>
  <table class="facts">
    <tr><td class="label">{{ t('plan.term_from') }}</td><td><span class="write-line"></span></td></tr>
    <tr><td class="label">{{ t('plan.term_to') }}</td><td><span class="write-line"></span></td></tr>
  </table>
  <table class="works">
    <thead>
      <tr><th class="lp">{{ t('techcard.col_no') }}</th><th>{{ t('techcard.surface') }}</th><th>{{ t('techcard.col_work') }}</th><th class="unit">{{ t('techcard.col_unit') }}</th><th class="brk">{{ t('techcard.col_break') }}</th></tr>
    </thead>
    <tbody>
      {% for w in room.works %}
      <tr><td class="lp">{{ w.number }}</td><td>{{ w.surface }}<div class="muted">{{ w.surface_type }}</div></td><td>{{ w.work }}</td><td class="unit">{{ w.unit }}</td><td class="brk">{% if w.wait_hours %}{{ t('techcard.break_hours', n=w.wait_hours) }}{% elif doc.working %}<span class="write-line"></span>{% endif %}</td></tr>
      {% endfor %}
      {% for _ in range(room.spare_rows) %}
      <tr class="spare"><td class="lp">{{ room.works | length + loop.index }}</td><td><span class="write-line"></span></td><td><span class="write-line"></span></td><td class="unit"><span class="write-line"></span></td><td class="brk"><span class="write-line"></span></td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% if room.total_wait_hours %}<p class="muted">{{ t('plan.total_breaks', n=room.total_wait_hours) }}</p>{% endif %}
</section>
{% endfor %}
<h2>{{ t('plan.adjacent') }}</h2>
{% if not doc.adjacent %}<p class="muted">{{ t('plan.adjacent_none') }}</p>{% endif %}
{% for a in doc.adjacent %}
<div class="adjacent">
  <table class="facts">
    <tr><td class="label">{{ t('plan.adj.work') }}</td><td>{{ field(a.work_name) }}</td></tr>
    <tr><td class="label">{{ t('plan.adj.performer') }}</td><td>{{ field(a.performer) }}</td></tr>
    <tr><td class="label">{{ t('plan.adj.rooms') }}</td><td>{{ field(a.rooms) }}</td></tr>
    <tr><td class="label">{{ t('plan.adj.period') }}</td><td>{{ field(a.period) }}</td></tr>
    <tr><td class="label">{{ t('plan.adj.order') }}</td><td>{{ field(a.order) }}</td></tr>
    {% if a.order_note or doc.working %}<tr><td class="label">{{ t('plan.adj.order_note') }}</td><td>{{ field(a.order_note) }}</td></tr>{% endif %}
    {% if a.responsibility_note or doc.working %}<tr><td class="label">{{ t('plan.adj.responsibility') }}</td><td>{{ field(a.responsibility_note) }}</td></tr>{% endif %}
    {% if a.coordination_note or doc.working %}<tr><td class="label">{{ t('plan.adj.coordination') }}</td><td>{{ field(a.coordination_note) }}</td></tr>{% endif %}
  </table>
</div>
{% endfor %}
</div>
