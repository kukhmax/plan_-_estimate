@font-face { font-family: "DejaVu Sans"; font-weight: 400; font-style: normal; src: url("{{ fonts_url }}/DejaVuSans.ttf"); }
@font-face { font-family: "DejaVu Sans"; font-weight: 700; font-style: normal; src: url("{{ fonts_url }}/DejaVuSans-Bold.ttf"); }

@page {
  size: A4;
  margin: 18mm 15mm 20mm 15mm;
  @bottom-left { content: element(footer); font: 400 7.5pt "DejaVu Sans"; color: #555; vertical-align: top; padding-top: 3mm; }
  @bottom-right { content: "{{ t('doc.page') }} " counter(page) " {{ t('doc.of') }} " counter(pages); font: 400 7.5pt "DejaVu Sans"; color: #555; vertical-align: top; padding-top: 3mm; }
}

html { font-family: "DejaVu Sans", sans-serif; font-size: 9.5pt; line-height: 1.4; color: #111; }
body { margin: 0; }
.running-footer { position: running(footer); font-size: 7.5pt; color: #555; }
h1 { font-size: 17pt; margin: 0 0 4mm 0; }
h2 { font-size: 12pt; margin: 6mm 0 2mm 0; page-break-after: avoid; }
p { margin: 0 0 2.5mm 0; orphans: 3; widows: 3; }
table { width: 100%; border-collapse: collapse; }
th, td { text-align: left; vertical-align: top; padding: 1.6mm 2mm; }
th { font-weight: 700; border-bottom: 0.4mm solid #111; }
td { border-bottom: 0.2mm solid #bbb; }
tr { page-break-inside: avoid; }
thead { display: table-header-group; }
.num { text-align: right; white-space: nowrap; }
.meta { width: auto; margin-bottom: 4mm; }
.meta td { border: 0; padding: 0.6mm 4mm 0.6mm 0; }
.meta .label { color: #555; }
.parties { display: flex; gap: 8mm; margin-bottom: 5mm; }
.party { flex: 1 1 0; border: 0.3mm solid #999; padding: 2.5mm 3mm; min-height: 22mm; }
.party .role { font-size: 8pt; text-transform: uppercase; letter-spacing: 0.3pt; color: #555; margin-bottom: 1mm; }
.party .name { font-weight: 700; }
.party .missing { color: #888; }
.signatures { display: flex; gap: 14mm; margin-top: 18mm; page-break-inside: avoid; }
.signature { flex: 1 1 0; border-top: 0.3mm solid #111; padding-top: 1.5mm; font-size: 8pt; color: #333; }
.generated-by { margin-top: 8mm; font-size: 7.5pt; color: #777; }

.watermark { position: fixed; top: 105mm; left: 0; width: 100%; text-align: center; transform: rotate(-30deg); font-size: 46pt; font-weight: 700; letter-spacing: 2pt; color: rgba(190, 30, 30, 0.16); z-index: -1; }
.object { margin-bottom: 4mm; }
.object .role { font-size: 8pt; text-transform: uppercase; letter-spacing: 0.3pt; color: #555; }
.version { color: #555; margin: -2mm 0 4mm 0; }
.notice { border: 0.3mm solid #b45309; color: #92400e; padding: 1.5mm 3mm; margin-bottom: 4mm; font-size: 8.5pt; }
.group-title { break-after: avoid; page-break-after: avoid; }
.group-title td { background: #eee; font-weight: 700; border-bottom: 0.3mm solid #999; }
.group-total td { font-weight: 700; border-bottom: 0.3mm solid #999; }
.grand-total td { font-weight: 700; font-size: 11pt; border-top: 0.5mm solid #111; border-bottom: 0; padding-top: 3mm; }
.detail { color: #555; font-size: 8pt; }
.estimate th.num, .estimate td.num { text-align: right; }
.estimate .lp { width: 9mm; white-space: nowrap; }
.estimate .unit { width: 14mm; white-space: nowrap; }
.pending { color: #92400e; font-style: italic; }
.report h2 { border-bottom: 0.3mm solid #999; padding-bottom: 1mm; }
.report h3 { font-size: 10.5pt; margin: 4mm 0 1.5mm 0; break-after: avoid; page-break-after: avoid; }
.report h4 { font-size: 9.5pt; margin: 3mm 0 1.5mm 0; break-after: avoid; page-break-after: avoid; }
.report .muted { color: #666; font-weight: 400; }
.photos { table-layout: fixed; margin-bottom: 1mm; }
.photos td { width: 50%; padding: 1mm 1.5mm; border: 0; vertical-align: top; }
.photos tr { break-inside: avoid; page-break-inside: avoid; }
.frame { position: relative; line-height: 0; }
.frame img { width: 100%; height: auto; display: block; }
.overlay { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.photo-caption { font-size: 8pt; line-height: 1.3; margin-top: 1mm; }
.photo-caption .legend { color: #333; }
.summary { color: #555; margin: -2mm 0 4mm 0; }

.photo-caption .place { color: #555; margin-bottom: 0.6mm; }
.inspection { margin: 1mm 0 3mm 0; }
.facts { width: auto; margin-bottom: 2mm; }
.facts td { border: 0; padding: 0.4mm 4mm 0.4mm 0; font-size: 9pt; }
.facts .label { color: #555; }
.answers { margin-bottom: 2mm; }
.answers td { font-size: 9pt; padding: 1mm 2mm; }
.answers .answer { text-align: right; font-weight: 700; white-space: nowrap; }
.answers-title td { background: #eee; font-weight: 700; }
.risk { border: 0.3mm solid #999; border-left-width: 1.4mm; padding: 1.5mm 3mm; margin-bottom: 2mm; font-size: 9pt; break-inside: avoid; page-break-inside: avoid; }
.risk-low { border-left-color: #65a30d; }
.risk-medium { border-left-color: #d97706; }
.risk-high { border-left-color: #ea580c; }
.risk-critical { border-left-color: #b91c1c; }
.risk-title { font-weight: 700; margin-bottom: 0.8mm; }
.risk .severity { text-transform: uppercase; font-size: 7.5pt; letter-spacing: 0.3pt; color: #444; margin-right: 1.5mm; }
.risk .blocks { margin-top: 0.8mm; color: #92400e; font-weight: 700; }

.recommended { margin-top: 6mm; }
.recommended p { margin-bottom: 1.5mm; }
.recommended { break-inside: avoid; page-break-inside: avoid; }
.recommended h2 { break-after: avoid; }
.recommended .grand-total { break-before: avoid; page-break-before: avoid; }
.skeleton-section { margin-bottom: 4mm; break-inside: avoid-page; }
.skeleton-section .muted { color: #888; font-style: italic; }
.skeleton-attachments ol { margin: 0 0 0 5mm; padding: 0; }
.skeleton-attachments li { margin-bottom: 1mm; }

.techcard h2 { border-bottom: 0.3mm solid #999; padding-bottom: 1mm; break-before: page; }
.techcard .tc-room:first-of-type h2 { break-before: auto; }
.techcard h3 { font-size: 10.5pt; margin: 4mm 0 1.5mm 0; break-after: avoid; page-break-after: avoid; }
.techcard h4 { font-size: 9.5pt; margin: 3mm 0 1.5mm 0; break-after: avoid; page-break-after: avoid; }
.techcard .muted { color: #666; font-weight: 400; }
.tc-surface { margin-bottom: 5mm; }
.techcard .works { margin-bottom: 2mm; }
.techcard .works th, .techcard .works td { font-size: 9pt; }
.techcard .works .lp { width: 9mm; white-space: nowrap; }
.techcard .works .unit { width: 14mm; white-space: nowrap; }
.techcard .works .brk { width: 34mm; }
.techcard .works .spare td { height: 8mm; }
.write-line { display: inline-block; min-width: 40mm; width: 100%; height: 5mm; border-bottom: 0.3mm solid #777; }
.write-box { height: 22mm; border: 0.3mm solid #999; margin-bottom: 2mm; }
.techcard .facts { width: 100%; }
.techcard .facts .label { width: 58mm; }
.techcard h2 .write-line, .techcard h3 .write-line { width: 105mm; min-width: 0; vertical-align: bottom; }
.watermark.light { color: rgba(190, 30, 30, 0.07); font-size: 40pt; }
.plan h2 { break-before: auto; }
.plan .plan-room { margin-bottom: 5mm; }
.plan .adjacent { margin-bottom: 4mm; break-inside: avoid; page-break-inside: avoid; }
.plan .works .muted { font-size: 8pt; }
.contract h2 { font-size: 11pt; margin: 6mm 0 2mm 0; border-bottom: 0.3mm solid #999; padding-bottom: 1mm; break-after: avoid; }
.contract h3 { font-size: 9.5pt; margin: 3mm 0 1.5mm 0; break-after: avoid; }
.contract .contract-section { margin-bottom: 3mm; }
.contract .muted { color: #888; font-style: italic; }
.contract .facts { width: 100%; }
.contract .facts .label { width: 62mm; }
.contract .clause { margin: 0 0 1.6mm 0; text-align: justify; }
.contract p .write-line { width: 34mm; min-width: 34mm; height: 1em; vertical-align: baseline; }
.contract .alternative { margin: 0 0 1.4mm 5mm; text-align: justify; }
.contract .status { margin: 2mm 0; }
.contract .box { white-space: nowrap; margin-right: 3mm; }
.contract .form .label { width: 95mm; }
.annex { break-before: page; }
.annex .annex-title { font-size: 12pt; margin: 0 0 3mm 0; border-bottom: 0.4mm solid #111; padding-bottom: 1mm; }
.annex .techcard h2, .annex .plan h2 { break-before: auto; }
.contract .persons { margin-bottom: 2mm; }
