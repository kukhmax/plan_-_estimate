# Development image for the React/Vite Mini App frontend.
# Source is bind-mounted at /app in compose so edits reflect without rebuilding.
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=development

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]